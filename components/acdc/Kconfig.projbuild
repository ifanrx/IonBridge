menu "ACDC Configuration"

    orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

    config ACDC_MODULE
        bool "Enable ACDC Module"
        default n
        help
            Enable the ACDC module for power management.
            This module is responsible for managing the power supply.

    config ACDC_OUTPUT_ADJUSTABLE
        bool "ACDC Output Adjustable"
        depends on ACDC_MODULE
        default y
        help
            Enable adjustable output for the ACDC module.
            This allows the output voltage to be adjusted based on the configuration.

    config ACDC_CURRENT_VOLTAGE_CONTROL
        bool "Current-based Voltage Control"
        depends on ACDC_MODULE && ACDC_OUTPUT_ADJUSTABLE
        default n
        help
            Enable current-based voltage control using PD negotiated current
            and measured Iout values. When enabled, the system monitors total
            port current demand and adjusts voltage levels accordingly.

    config ACDC_CURRENT_MAX_LEVEL0
        int "Max current for Level 0 (mA)"
        depends on ACDC_CURRENT_VOLTAGE_CONTROL
        default 6000
        help
            Maximum current capacity in mA for voltage level 0.

    config ACDC_CURRENT_MAX_LEVEL1
        int "Max current for Level 1 (mA)"
        depends on ACDC_CURRENT_VOLTAGE_CONTROL
        default 6000
        help
            Maximum current capacity in mA for voltage level 1.

    config ACDC_CURRENT_MAX_LEVEL2
        int "Max current for Level 2 (mA)"
        depends on ACDC_CURRENT_VOLTAGE_CONTROL
        default 5500
        help
            Maximum current capacity in mA for voltage level 2.

    config ACDC_CURRENT_MAX_LEVEL3
        int "Max current for Level 3 (mA)"
        depends on ACDC_CURRENT_VOLTAGE_CONTROL && ACDC_OUTPUT_VOLTAGE_LEVELS > 3
        default 5500
        help
            Maximum current capacity in mA for voltage level 3.

    config ACDC_FEEDBACK_SIGNAL_H
        int "ACDC Feedback Signal High"
        depends on ACDC_MODULE
        range 0 1
        default 1
        help
            ACDC feedback signal high level.
            This setting determines the high level of the feedback signal.
            0: Low, 1: High.

    config ACDC_FEEDBACK_SIGNAL_L
        int "ACDC Feedback Signal Low"
        depends on ACDC_MODULE
        range 0 1
        default 0
        help
            ACDC feedback signal low level.
            This setting determines the low level of the feedback signal.
            0: Low, 1: High.

    config ACDC_FEEDBACK_PIN0
        int "ACDC Feedback Pin 0"
        depends on ACDC_MODULE
        range 0 21
        default 20
        help
            GPIO pin number for ACDC feedback signal 0.
            This pin is used to monitor the feedback from the ACDC module.

    config ACDC_FEEDBACK_PIN1
        int "ACDC Feedback Pin 1"
        depends on ACDC_MODULE && ACDC_OUTPUT_VOLTAGE_LEVELS > 2
        range 0 21
        default 21
        help
            GPIO pin number for ACDC feedback signal 1.
            This pin is used to monitor the feedback from the ACDC module.

    config ACDC_OUTPUT_VOLTAGE_LEVELS
        int "ACDC Output Voltage Levels"
        depends on ACDC_MODULE
        default 3
        range 2 4
        help
            Number of output voltage levels for the ACDC module.
            This setting determines how many different voltage levels can be set.

    config ACDC_OUTPUT_VOLTAGE_LEVEL0
        int "ACDC Output Voltage Level 0, mV"
        depends on ACDC_MODULE && ACDC_OUTPUT_VOLTAGE_LEVELS > 0
        default 12000
        help
            Output voltage level 0 for the ACDC module.
            This value is used to set the first output voltage level.
            Units: mV.

    config ACDC_OUTPUT_VOLTAGE_LEVEL1
        int "ACDC Output Voltage Level 1, mV"
        depends on ACDC_MODULE && ACDC_OUTPUT_VOLTAGE_LEVELS > 1
        default 20000
        help
            Output voltage level 1 for the ACDC module.
            This value is used to set the second output voltage level.
            Units: mV.

    config ACDC_OUTPUT_VOLTAGE_LEVEL2
        int "ACDC Output Voltage Level 2, mV"
        depends on ACDC_MODULE && ACDC_OUTPUT_VOLTAGE_LEVELS > 2
        default 28000
        help
            Output voltage level 2 for the ACDC module.
            This value is used to set the third output voltage level.
            Units: mV.

    config ACDC_OUTPUT_VOLTAGE_LEVEL3
        int "ACDC Output Voltage Level 3, mV"
        depends on ACDC_MODULE && ACDC_OUTPUT_VOLTAGE_LEVELS > 3
        default 30000
        help
            Output voltage level 3 for the ACDC module.
            This value is used to set the fourth output voltage level.
            Units: mV.

menu "ACDC Self-Test Voltage Tolerances"
        depends on ACDC_MODULE

        config ACDC_VOLTAGE_TOLERANCE_LOWER_L0
            int "Lower tolerance for Level 0 (mV)"
            depends on ACDC_OUTPUT_VOLTAGE_LEVELS > 0
            default 300
            help
                How far below expected voltage is acceptable at Level 0.
                Valid range: (expected - this, expected + upper_tolerance)

        config ACDC_VOLTAGE_TOLERANCE_UPPER_L0
            int "Upper tolerance for Level 0 (mV)"
            depends on ACDC_OUTPUT_VOLTAGE_LEVELS > 0
            default 300
            help
                How far above expected voltage is acceptable at Level 0.

        config ACDC_VOLTAGE_TOLERANCE_LOWER_L1
            int "Lower tolerance for Level 1 (mV)"
            depends on ACDC_OUTPUT_VOLTAGE_LEVELS > 1
            default 500
            help
                How far below expected voltage is acceptable at Level 1.

        config ACDC_VOLTAGE_TOLERANCE_UPPER_L1
            int "Upper tolerance for Level 1 (mV)"
            depends on ACDC_OUTPUT_VOLTAGE_LEVELS > 1
            default 500
            help
                How far above expected voltage is acceptable at Level 1.

        config ACDC_VOLTAGE_TOLERANCE_LOWER_L2
            int "Lower tolerance for Level 2 (mV)"
            depends on ACDC_OUTPUT_VOLTAGE_LEVELS > 2
            default 700
            help
                How far below expected voltage is acceptable at Level 2.

        config ACDC_VOLTAGE_TOLERANCE_UPPER_L2
            int "Upper tolerance for Level 2 (mV)"
            depends on ACDC_OUTPUT_VOLTAGE_LEVELS > 2
            default 700
            help
                How far above expected voltage is acceptable at Level 2.

        config ACDC_VOLTAGE_TOLERANCE_LOWER_L3
            int "Lower tolerance for Level 3 (mV)"
            depends on ACDC_OUTPUT_VOLTAGE_LEVELS > 3
            default 0
            help
                How far below expected voltage is acceptable at Level 3.

        config ACDC_VOLTAGE_TOLERANCE_UPPER_L3
            int "Upper tolerance for Level 3 (mV)"
            depends on ACDC_OUTPUT_VOLTAGE_LEVELS > 3
            default 1500
            help
                How far above expected voltage is acceptable at Level 3.

    endmenu

endmenu
