menu "Global Logging Settings"

config SYSLOG_HOST
    string "Syslog host"
    default "172.25.16.125"
    help
        The host of the syslog report.

config SYSLOG_HOST_FALLBACK_IP
    string "Syslog host fallback ip"
    default "120.232.156.194"
    help
        The host of the syslog report.

config SYSLOG_PORT
    int "Syslog port"
    default 1515
    help
        The port of the syslog report.

config SYSLOG_SEMAPHORE_TIMEOUT_MS
    int "Syslog semaphore timeout (ms)"
    default 1000
    help
        The timeout of the semaphore used to prevent multiple threads from sending
        logs to the same syslog server simultaneously.

config SYSLOG_MESSAGE_BUFFER_SIZE
    int "Syslog message buffer size"
    default 384
    range 128 1024
    help
        The size of the buffer used to store syslog messages before they are sent.
        This should be large enough to hold the largest expected log message.

config SYSLOG_COLLECTOR_BUFFER_SIZE
    int "Syslog collector buffer size"
    default 256
    range 128 512
    help
        The size of the buffer used to collect syslog messages before they are sent.
        This should be large enough to hold multiple log messages.

endmenu
